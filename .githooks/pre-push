#!/bin/sh
# pre-push: everything CI will check, so a red pipeline is a local failure.
set -e

# `cargo install` puts binaries in $CARGO_HOME/bin, which is not on PATH in every
# shell — CI images, sandboxes, minimal dotfiles. Looking there too is the difference
# between running the audit and printing "skipping" while calling it a gate.
tool() {
  command -v "$1" 2>/dev/null || {
    for candidate in "${CARGO_HOME:-$HOME/.cargo}/bin/$1" "$HOME/.cargo/bin/$1"; do
      if [ -x "$candidate" ]; then
        printf '%s\n' "$candidate"
        return 0
      fi
    done
    return 1
  }
}

cargo test --all-features --quiet

if deny=$(tool cargo-deny); then
  "$deny" check
else
  echo "pre-push: cargo-deny not installed - skipping (CI still enforces it)"
  echo "pre-push: install with: cargo install cargo-deny --locked"
fi

if audit=$(tool cargo-audit); then
  "$audit" audit
else
  echo "pre-push: cargo-audit not installed - skipping (CI still enforces it)"
  echo "pre-push: install with: cargo install cargo-audit --locked"
fi

# --- ai-review: staged secrets only ---------------------------------------------------
# A committed .env or key is a fact, so it belongs in a gate: no model call, no network,
# well under a second. The full review (scope gaps, N+1, broken contracts) is a judgement,
# not a fact — it runs on the PR, where a human can disagree and the record stays visible.
git fetch origin main --quiet 2>/dev/null || true   # a stale base narrows what gets scanned
if command -v ai-review >/dev/null 2>&1; then
  run_ai_review() { ai-review "$@"; }
else
  run_ai_review() { npx -y @dandrok/ai-review@latest "$@"; }
fi

if ! run_ai_review --version >/dev/null 2>&1; then
  echo "pre-push: ai-review unavailable (no node/npx/network) - skipping the secrets scan"
else
  set +e
  # JSON mode, because exit 1 is ambiguous: npx exits 1 when it cannot fetch the package.
  ar_out=$(run_ai_review review --base origin/main --static-only --fail-on warning --format json --quiet 2>&1)
  ar_status=$?
  set -e
  # Count findings, not the envelope: an empty array still prints the word "findings".
  # Only a non-zero count justifies blocking, and only a zero count with a non-zero exit
  # means the scan never ran.
  ar_count=$(printf '%s' "$ar_out" | grep -c '"file":' || true)
  if [ "$ar_count" -gt 0 ]; then
    echo "pre-push: $ar_count credential finding(s) in these commits:"
    printf '%s\n' "$ar_out" | grep -E '"title"|"file"|"start_line"' | sed 's/^ */  /'
    echo "pre-push: fix it, or bypass with: git push --no-verify"
    exit 1
  fi
  if [ "$ar_status" -ne 0 ]; then
    echo "pre-push: ai-review exited $ar_status with no findings - not blocking"
  fi
fi
